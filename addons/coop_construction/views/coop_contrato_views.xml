<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coop_contrato_form" model="ir.ui.view">
        <field name="name">coop.contrato.form</field>
        <field name="model">coop.contrato</field>
        <field name="arch" type="xml">
            <form string="Contrato de obra">
                <header>
                    <field name="estado" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group string="Contrato">
                            <field name="name"/>
                            <field name="obra_id"/>
                            <field name="comitente_id"/>
                            <field name="monto_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Plazos de palabra (alimentan el CPM)">
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>
                    <group string="Plazos del papel firmado (reconcilian, no pisan)"
                           invisible="estado != 'firmado'">
                        <field name="fecha_inicio_firmado"/>
                        <field name="fecha_fin_firmado"/>
                        <field name="fechas_divergen"/>
                        <div class="alert alert-warning" role="alert"
                             colspan="2" invisible="not fechas_divergen">
                            El papel firmado trae fechas distintas a las
                            acordadas de palabra. El atraso de la obra se sigue
                            calculando contra las de palabra; revisá la
                            diferencia.
                        </div>
                    </group>
                    <group string="Condiciones">
                        <field name="condiciones" nolabel="1"/>
                    </group>
                    <group string="Documento firmado en papel">
                        <field name="documento" filename="documento_filename"/>
                        <field name="documento_filename" invisible="1"/>
                        <div class="text-muted" colspan="2">
                            La firma del comitente todavía no está implementada.
                            Con el contrato en estado "Firmado" se adjunta el
                            papel firmado a mano.
                        </div>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_coop_contrato_list" model="ir.ui.view">
        <field name="name">coop.contrato.list</field>
        <field name="model">coop.contrato</field>
        <field name="arch" type="xml">
            <list string="Contratos">
                <field name="name"/>
                <field name="obra_id"/>
                <field name="comitente_id"/>
                <field name="estado"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="fechas_divergen" optional="hide"/>
                <field name="monto_total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_coop_contrato" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">coop.contrato</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cargá el contrato de la obra: comitente, monto, condiciones y
                las fechas de inicio y fin.
            </p>
        </field>
    </record>
</odoo>
