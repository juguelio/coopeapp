<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coop_contrato_form" model="ir.ui.view">
        <field name="name">coop.contrato.form</field>
        <field name="model">coop.contrato</field>
        <field name="arch" type="xml">
            <form string="Contrato de obra">
                <sheet>
                    <group>
                        <group string="Contrato">
                            <field name="name"/>
                            <field name="obra_id"/>
                            <field name="comitente_id"/>
                            <field name="monto_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Plazos">
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                    </group>
                    <group string="Condiciones">
                        <field name="condiciones" nolabel="1"/>
                    </group>
                    <group string="Documento firmado en papel">
                        <field name="documento" filename="documento_filename"/>
                        <field name="documento_filename" invisible="1"/>
                        <div class="text-muted" colspan="2">
                            La firma del comitente todavía no está implementada.
                            Por ahora se adjunta el contrato firmado en papel.
                        </div>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_coop_contrato_list" model="ir.ui.view">
        <field name="name">coop.contrato.list</field>
        <field name="model">coop.contrato</field>
        <field name="arch" type="xml">
            <list string="Contratos">
                <field name="name"/>
                <field name="obra_id"/>
                <field name="comitente_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="monto_total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_coop_contrato" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">coop.contrato</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cargá el contrato de la obra: comitente, monto, condiciones y
                las fechas de inicio y fin.
            </p>
        </field>
    </record>
</odoo>
