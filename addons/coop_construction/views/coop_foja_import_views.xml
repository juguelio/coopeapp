<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coop_foja_import_form" model="ir.ui.view">
        <field name="name">coop.foja.import.form</field>
        <field name="model">coop.foja.import</field>
        <field name="arch" type="xml">
            <form string="Importar foja de medición">
                <group>
                    <group>
                        <field name="obra_id" readonly="analizado"/>
                        <field name="archivo" filename="nombre_archivo"
                               readonly="analizado"/>
                        <field name="nombre_archivo" invisible="1"/>
                        <field name="analizado" invisible="1"/>
                    </group>
                    <group invisible="not analizado">
                        <field name="hoja"/>
                        <field name="hojas_disponibles"/>
                        <field name="nivel"/>
                        <field name="reemplazar"/>
                    </group>
                </group>

                <div invisible="analizado" class="alert alert-info" role="alert">
                    Subí el cómputo y presupuesto en .xlsx. Primero se lee y se
                    muestra qué se entendió; nada se crea hasta que lo confirmes.
                </div>

                <group invisible="not analizado">
                    <field name="resumen" nolabel="1" readonly="1"
                           widget="text"/>
                </group>

                <field name="linea_ids" invisible="not analizado" nolabel="1">
                    <list editable="bottom" decoration-warning="aviso"
                          decoration-muted="not importar">
                        <field name="importar" widget="boolean_toggle"/>
                        <field name="fila" readonly="1"/>
                        <field name="codigo"/>
                        <field name="descripcion"/>
                        <field name="uom"/>
                        <field name="cantidad"/>
                        <field name="precio_unitario"/>
                        <field name="importe" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="aviso" readonly="1"/>
                    </list>
                </field>

                <footer>
                    <button name="action_analizar" type="object"
                            string="Leer el archivo" class="btn-primary"
                            invisible="analizado"/>
                    <button name="action_cambiar_nivel" type="object"
                            string="Releer con este nivel"
                            invisible="not analizado"/>
                    <button name="action_importar" type="object"
                            string="Importar lo tildado" class="btn-primary"
                            invisible="not analizado"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_coop_foja_import" model="ir.actions.act_window">
        <field name="name">Importar foja desde cómputo</field>
        <field name="res_model">coop.foja.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_coop_foja_import"
              name="Importar foja desde cómputo"
              parent="menu_coop_medicion"
              action="action_coop_foja_import"
              sequence="25"/>
</odoo>
