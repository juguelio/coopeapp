<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Puente desde la oficina (/web/login) hacia la app (/app/ingresar) -->
    <template id="coop_login_app_bridge" inherit_id="web.login">
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="after">
            <p class="mt-3 mb-0 text-center">
                <a href="/app/ingresar"
                   style="color:#1a7f4e;font-weight:600;text-decoration:none">
                    📱 La app de la cooperativa — entrá con tu teléfono y PIN →
                </a>
            </p>
        </xpath>
    </template>

    <!-- Saca el footer "Con la tecnología de Odoo" + gestor de bases del login -->
    <template id="coop_login_no_brand" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('border-top')]" position="replace"/>
    </template>

    <!-- Saca el "¿No tienes una cuenta?" (registro público) → solo por invitación -->
    <function model="ir.config_parameter" name="set_param">
        <value>auth_signup.invitation_scope</value>
        <value>b2b</value>
    </function>
</odoo>
