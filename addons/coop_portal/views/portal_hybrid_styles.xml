<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hybrid_styles" name="App: Cartel y Obra, fase 1">
        <!-- Inline para conservar el HTML autosuficiente del portal offline.
             Las clases se activan solo en las superficies de esta fase. -->
        <style>
            .ui-cartel,.ui-obra{--plano:#0e2e4a;--accion:#c34412;--papel:#faf9f6;
                --tinta:#0b1114;--gris:#52616c;--verde:#087747;--verde-claro:#e5f2e9;
                --amarillo:#f2b01e;--rojo:#b3261e;--radio:0px;
                background:var(--papel);font-family:Arial,Helvetica,sans-serif;line-height:1.45}
            .ui-cartel *,.ui-obra *{min-width:0}
            .ui-cartel a,.ui-cartel button,.ui-obra a,.ui-obra button{touch-action:manipulation}
            .ui-cartel :focus-visible,.ui-obra :focus-visible{outline:3px solid var(--tinta);outline-offset:3px}
            .ui-cartel a,.ui-obra a{overflow-wrap:anywhere}
            .ui-cartel .ux-content,.ui-obra .ux-content{overflow-wrap:anywhere}
            .ux-icon{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2;
                stroke-linecap:butt;stroke-linejoin:miter;flex:none;vertical-align:middle}
            .ux-sprite{position:absolute;width:0;height:0;overflow:hidden}
            .ui-cartel .nav,.ui-obra .nav{background:var(--plano);border:0;padding:0 0 env(safe-area-inset-bottom)}
            .ui-cartel .nav a,.ui-obra .nav a{min-height:72px;justify-content:center;
                color:#fff;padding:10px 3px;font-size:13px}
            .ui-cartel .nav a.viva,.ui-obra .nav a.viva{background:var(--accion);color:#fff}
            .ui-cartel .nav a:focus-visible,.ui-obra .nav a:focus-visible{outline-color:#fff;outline-offset:-4px}
            .ui-cartel .ux-footer,.ui-obra .ux-footer{display:flex;flex-wrap:wrap;
                justify-content:center;gap:8px;padding:24px 16px!important}
            .ui-cartel .ux-footer a,.ui-obra .ux-footer a{min-height:56px;display:flex;
                align-items:center;justify-content:center;flex:1 1 130px;padding:12px;
                color:var(--plano)!important;border:2px solid var(--plano);font-weight:700}
            .ui-cartel .ux-footer > span,.ui-obra .ux-footer > span{display:none}
            .ui-cartel .botonazo,.ui-obra .botonazo{min-height:60px;background:var(--accion);color:#fff}
            .ui-cartel .botonazo.sec,.ui-obra .botonazo.sec{background:var(--papel);color:var(--plano);border:2px solid var(--plano)}
            .ui-cartel .chip,.ui-obra .chip{border-radius:0;white-space:normal;line-height:1.4}
            .ui-cartel .chip.espera,.ui-obra .chip.espera{background:var(--amarillo);color:var(--tinta)}
            .ui-cartel .chip.ok,.ui-obra .chip.ok{background:var(--verde);color:#fff}

            /* B / Cartel: planos enteros, una acción, lectura sin planilla. */
            .ui-cartel{max-width:560px;padding:0 0 96px;font-size:18px}
            .ui-cartel .nav{max-width:560px}
            .ui-cartel h1{font-size:40px;line-height:1.08;font-weight:900}
            .ui-cartel .ux-content > h1{background:var(--plano);color:#fff;padding:26px 20px 14px;margin:0}
            .ui-cartel .ux-content > .sub{background:var(--plano);color:#e4edf3;padding:0 20px 22px;margin:0;font-size:17px}
            .ui-cartel .ux-content > .atras{background:var(--plano);color:#fff;display:flex;padding:16px 20px;margin:0}
            .ui-cartel .ux-content > .paso{background:var(--plano);color:#e4edf3;padding:16px 20px 0;margin:0}
            .ui-cartel .ux-content > .pregunta{background:var(--plano);color:#fff;padding:18px 20px 24px;margin:0}
            .ui-cartel .pregunta{font-size:34px;font-weight:900;line-height:1.15}
            .ui-cartel .paso{font-size:16px;text-transform:none;letter-spacing:normal}
            .ui-cartel .card{border-radius:0;box-shadow:none;background:var(--papel);
                padding:22px 20px;margin:0;border-bottom:2px solid #dedbd2}
            .ui-cartel .card h3{font-size:19px;text-transform:none;color:var(--tinta);margin-bottom:12px}
            .ui-cartel .botonazo{border-radius:0;font-size:23px;font-weight:900;line-height:1.2;
                padding:20px;margin:0;gap:14px;text-align:center;min-height:72px}
            .ui-cartel .ux-primary{box-shadow:inset 0 -5px 0 #8c2e08}
            .ui-cartel .ux-primary .ux-icon{width:32px;height:32px}
            .ui-cartel .botonazo.sec{font-size:18px;font-weight:700;box-shadow:none;min-height:60px}
            .ui-cartel .ux-content > form{padding:22px 20px}
            .ui-cartel .numero-grande{border-radius:0;font-size:64px;font-weight:900;
                border:2px solid var(--plano);max-width:100%;color:var(--tinta);background:#fff}
            .ui-cartel input,.ui-cartel select,.ui-cartel textarea{max-width:100%;min-height:56px;font:inherit}
            .ui-cartel input[type=radio]{min-height:24px;width:24px;height:24px;accent-color:var(--plano)}
            .ui-cartel label.radio{border-radius:0;min-height:64px;font-size:19px}
            .ui-cartel .opcion{border-radius:0;margin:0;min-height:76px;font-size:21px;
                border:0;border-bottom:2px solid #dedbd2;padding:20px;flex-wrap:wrap;background:var(--papel)}
            .ui-cartel .opcion span:first-child{flex:1 1 190px}
            .ui-cartel .atras{min-height:56px;padding:16px 0;font-size:17px;align-items:center}
            .ui-cartel .fila{flex-direction:column;align-items:flex-start;gap:8px;font-size:18px;padding:18px 0}
            .ui-cartel .chip{font-size:16px;font-weight:700;padding:8px 12px}
            .ui-cartel .nro{font-size:clamp(56px,20vw,104px);font-weight:900;line-height:1;overflow-wrap:anywhere}
            .ui-cartel .ux-amount{font-size:28px;font-weight:800;line-height:1.2;margin:8px 0}
            .ui-cartel .ux-metric{background:var(--plano);color:#fff;padding:28px 20px}
            .ui-cartel .ux-metric h2{font-size:20px;font-weight:500;margin-bottom:14px}
            .ui-cartel .ux-metric .sub{color:#e4edf3;font-size:17px;margin:14px 0 0}
            .ui-cartel .ux-note{font-size:17px;color:var(--gris);margin-top:10px}
            .ui-cartel .ux-status{display:inline-block;padding:8px 12px;background:var(--amarillo);color:var(--tinta);font-weight:700}
            .ui-cartel .ux-status.paid{background:var(--verde);color:#fff}
            .ui-cartel .listo{padding:32px 20px;text-align:left;align-items:stretch}
            .ui-cartel .check{border-radius:0;background:var(--amarillo);color:var(--tinta);width:80px;height:80px}
            .ui-cartel .listo .sub{font-size:18px;line-height:1.5}
            .ui-cartel details.faq{border-radius:0;box-shadow:none;margin:0;border-bottom:2px solid #dedbd2}
            .ui-cartel details.faq summary{font-size:20px;min-height:72px;padding:20px}
            .ui-cartel details.faq summary::after{color:var(--plano)}
            .ui-cartel details.faq .resp{font-size:18px;padding:0 20px 22px}
            .ui-cartel details.faq .resp b{color:var(--plano)}
            .ui-cartel .ux-other-row{padding:18px 0;border-bottom:2px solid #dedbd2}
            .ui-cartel .ux-other-row > *{margin-bottom:8px}
            .ui-cartel #form-otro > div:has(>select){flex-wrap:wrap}
            .ui-cartel #form-otro select{width:100%}

            /* A / Obra: mismo cianotipo, renglones compactos y ancho de trabajo. */
            .ui-obra{max-width:1120px;padding:24px 20px 100px;font-size:16px;border-top:8px solid var(--accion)}
            .ui-obra .nav{max-width:1120px}
            .ui-obra h1{font-size:30px;color:var(--plano);font-weight:900}
            .ui-obra .card{border-radius:0;box-shadow:none;border:1px solid #d3d0c6;border-top:3px solid var(--plano)}
            .ui-obra .card h3{color:var(--plano)}
            .ui-obra .fila{flex-wrap:wrap;align-items:center;border-color:#d3d0c6}
            .ui-obra .nro{font-variant-numeric:tabular-nums}
            .ui-obra .barra{border-radius:0;background:#dedbd2}
            .ui-obra .barra > div{background:var(--plano)}
            @media(min-width:800px){
                .ui-obra .ux-content > .botonazo{display:inline-flex;width:auto;min-width:180px;padding:14px 20px;margin-right:8px}
                .ui-obra .fila{gap:20px}
            }
        </style>
    </template>
</odoo>
